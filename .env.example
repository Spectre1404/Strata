# Copy to .env. Never commit .env. Shiv shares values privately.

# MongoDB Atlas (Hackathon Sandbox). One database user per role.
MONGODB_URI_ADMIN=            # Shiv only, setup scripts only
MONGODB_URI_RESEARCHER=
MONGODB_URI_AUDITOR=
MONGODB_URI_STRATEGIST=
MONGODB_URI_GROUPER=
MONGODB_URI_WORKER=
MONGODB_URI_APP=
MONGODB_DB=strata
MONGODB_DB_TEST=strata_test

# Anthropic API (agent runtime, separate from Claude Code)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_RESEARCHER=claude-sonnet-5-5
ANTHROPIC_MODEL_LABELER=claude-haiku-5-5

# Voyage via Atlas Embedding and Reranking API
VOYAGE_API_KEY=
VOYAGE_ENDPOINT=https://ai.mongodb.com/v1/embeddings
VOYAGE_MODEL=voyage-finance-2

# Raindrop
RAINDROP_WRITE_KEY=

# Data (DECISIONS D1, D5, D11)
BAR_INTERVAL=1h          # D1
UNIVERSE_SIZE=30         # D1
CANDIDATE_POOL=50        # proposed: pairs downloaded so the top 30 can be re-selected monthly; confirm against D8
RESEARCH_START=2020-01-01
RESEARCH_END=2025-01-01  # first timestamp of the Vault
VAULT_END=2026-10-01
FEE_BPS=                 # set in S4, source recorded in D5
SPREAD_BPS=              # set in S4, source recorded in D5

# Auditor
PASS_LEVEL=0.95
VAULT_OPEN_BUDGET=5
